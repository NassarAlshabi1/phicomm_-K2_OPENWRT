#!/bin/sh
# shellcheck disable=SC3043,SC2317,SC2015
# =========================================================
# FLOOR1 - FIRST BOOT CONFIGURATION
# OpenWrt 24.10 | Phicomm K2 v22.5 (MT7620A + 5GHz radio)
#
# Wireless Mesh + BATMAN-ADV + LAN Bridge
# OPTIMIZED FOR MAX THROUGHPUT & COVERAGE
#
# Source: firstboot-phicomm-k2.sh provided by the owner
# (2026-11-12). Runs automatically ONCE on first boot via
# the uci-defaults mechanism (deleted after success).
#
# Changes made for first-boot integration (documented):
#   - removed the /root backup step (fresh image, nothing
#     to back up yet)
#   - removed the restart/reload commands and their sleeps:
#     uci-defaults run BEFORE services start, so network
#     and wireless come up with this configuration already
#     in place on this very first boot
#   - deletes the stock 'OpenWrt' AP interfaces
#     (default_radio0 / default_radio1) that a fresh image
#     creates, so only the Aden-Net APs and the mesh remain
#   - added 'del_list bat0' before re-adding it (idempotency
#     in case the script ever runs twice)
#   - added MTU 2304 on the batman-adv hardif (802.11s
#     headroom, standard for max throughput)
#   - guarded logger / cron / odhcpd calls so a transient
#     failure cannot abort the configuration
# Everything else is exactly as provided.
# =========================================================

# shellcheck source=/dev/null
. /lib/functions.sh

set -e

# =========================================================
# 1. NODE SETTINGS - CHANGE PER DEVICE
# =========================================================
NODE_NAME="Floor1"
NODE_IP="10.0.0.8"
NODE_MASK="255.255.0.0"
GATEWAY_IP="10.0.0.1"
DNS_IP="10.0.0.1"

# =========================================================
# 2. WIRELESS SETTINGS - SAME ON ALL MESH NODES
# =========================================================
MESH_ID="M87986"
MESH_KEY="11223344"
MESH_CHANNEL="44"
MESH_HTMODE="VHT80"

SSID_5G="✨ADEN-NET✨-5G"
SSID_2G="✨ADEN-NET✨-4G"

MESH_SECTION="wifinet2"
AP5_SECTION="wifinet1"
AP2_SECTION="w2"

# =========================================================
# 3. VALIDATION
# =========================================================
[ -x /sbin/uci ] || { echo "ERROR: UCI not found"; exit 1; }
[ -f /etc/config/network ] || exit 1
[ -f /etc/config/wireless ] || exit 1
[ -f /etc/config/dhcp ] || exit 1
[ -f /lib/netifd/proto/batadv.sh ] || { echo "ERROR: BATMAN-ADV protocol missing"; exit 1; }
[ -f /lib/netifd/proto/batadv_hardif.sh ] || { echo "ERROR: BATMAN hardif protocol missing"; exit 1; }

# =========================================================
# 4. DETECT RADIOS
#    (safe on first boot: 'wifi config' has already created
#     /etc/config/wireless before uci-defaults run)
# =========================================================
RADIO5=""
RADIO2=""

detect_radios() {
    local section="$1"
    local band path
    config_get band "$section" band
    config_get path "$section" path

    if [ -z "$RADIO5" ]; then
        if [ "$band" = "5g" ] || echo "$path" | grep -q "pci"; then
            RADIO5="$section"
        fi
    fi

    if [ -z "$RADIO2" ]; then
        if [ "$band" = "2g" ] || echo "$path" | grep -q "10180000.wmac"; then
            RADIO2="$section"
        fi
    fi
}

config_load wireless
config_foreach detect_radios wifi-device

[ -n "$RADIO5" ] && [ -n "$RADIO2" ] || { echo "ERROR: Wireless radios not detected"; exit 1; }

# =========================================================
# 5. DETECT BR-LAN
# =========================================================
BRIDGE_SECTION=""

find_bridge() {
    local section="$1"
    local name
    config_get name "$section" name
    [ "$name" = "br-lan" ] && BRIDGE_SECTION="$section"
}

config_load network
config_foreach find_bridge device

[ -n "$BRIDGE_SECTION" ] || { echo "ERROR: br-lan not found"; exit 1; }

# =========================================================
# 6. BACKUP - not needed on first boot (fresh image)
# =========================================================

# =========================================================
# 7. BATMAN MAIN INTERFACE
# =========================================================
uci -q delete network.bat0 || true
uci set network.bat0='interface'
uci set network.bat0.proto='batadv'
uci set network.bat0.routing_algo='BATMAN_V'
uci set network.bat0.bridge_loop_avoidance='1'
uci set network.bat0.distributed_arp_table='1'
uci set network.bat0.multicast_mode='1'
uci set network.bat0.gw_mode='off'

# =========================================================
# 8. WIRELESS BATMAN HARDIF
# =========================================================
uci -q delete network.batmesh || true
uci set network.batmesh='interface'
uci set network.batmesh.proto='batadv_hardif'
uci set network.batmesh.master='bat0'
uci set network.batmesh.mtu='2304'

uci -q delete network.batwire || true

# =========================================================
# 9. BR-LAN CONFIGURATION
# =========================================================
uci set network."$BRIDGE_SECTION".stp='1'
uci set network."$BRIDGE_SECTION".igmp_snooping='0'

uci -q del_list network."$BRIDGE_SECTION".ports='bat0' || true
uci -q del_list network."$BRIDGE_SECTION".ports='eth0.1' || true
uci add_list network."$BRIDGE_SECTION".ports='eth0.1'
uci add_list network."$BRIDGE_SECTION".ports='bat0'

# =========================================================
# 10. 5GHz RADIO (mesh backhaul)
# =========================================================
uci set wireless."$RADIO5".channel="$MESH_CHANNEL"
uci set wireless."$RADIO5".htmode="$MESH_HTMODE"
uci set wireless."$RADIO5".country='US'
uci set wireless."$RADIO5".disabled='0'

# =========================================================
# 11. 2.4GHz RADIO (client AP)
# =========================================================
uci set wireless."$RADIO2".channel='6'
uci set wireless."$RADIO2".htmode='HT20'
uci set wireless."$RADIO2".country='US'
uci set wireless."$RADIO2".disabled='0'

# =========================================================
# 11b. REMOVE STOCK AP INTERFACES
#     (a fresh image ships open 'OpenWrt' APs on both
#      radios - they would broadcast next to ours)
# =========================================================
uci -q delete wireless.default_radio0 || true
uci -q delete wireless.default_radio1 || true

# =========================================================
# 12. 5GHz ACCESS POINT
# =========================================================
uci -q delete wireless."$AP5_SECTION" || true
uci set wireless."$AP5_SECTION"='wifi-iface'
uci set wireless."$AP5_SECTION".device="$RADIO5"
uci set wireless."$AP5_SECTION".mode='ap'
uci set wireless."$AP5_SECTION".network='lan'
uci set wireless."$AP5_SECTION".ssid="$SSID_5G"
uci set wireless."$AP5_SECTION".encryption='none'
uci set wireless."$AP5_SECTION".isolate='1'
uci set wireless."$AP5_SECTION".disassoc_low_ack='0'
uci set wireless."$AP5_SECTION".dtim_period='10'
uci set wireless."$AP5_SECTION".wmm='1'
uci set wireless."$AP5_SECTION".multicast_to_unicast='1'
uci set wireless."$AP5_SECTION".ieee80211k='1'
uci set wireless."$AP5_SECTION".ieee80211v='1'
uci set wireless."$AP5_SECTION".bss_transition='1'
uci set wireless."$AP5_SECTION".disabled='0'

# =========================================================
# 13. 2.4GHz ACCESS POINT
# =========================================================
uci -q delete wireless."$AP2_SECTION" || true
uci set wireless."$AP2_SECTION"='wifi-iface'
uci set wireless."$AP2_SECTION".device="$RADIO2"
uci set wireless."$AP2_SECTION".mode='ap'
uci set wireless."$AP2_SECTION".network='lan'
uci set wireless."$AP2_SECTION".ssid="$SSID_2G"
uci set wireless."$AP2_SECTION".encryption='none'
uci set wireless."$AP2_SECTION".isolate='1'
uci set wireless."$AP2_SECTION".disassoc_low_ack='0'
uci set wireless."$AP2_SECTION".dtim_period='20'
uci set wireless."$AP2_SECTION".wmm='1'
uci set wireless."$AP2_SECTION".multicast_to_unicast='1'
uci set wireless."$AP2_SECTION".ieee80211k='1'
uci set wireless."$AP2_SECTION".ieee80211v='1'
uci set wireless."$AP2_SECTION".bss_transition='1'
uci set wireless."$AP2_SECTION".disabled='0'

# =========================================================
# 14. 802.11s MESH
# =========================================================
uci -q delete wireless."$MESH_SECTION" || true
uci set wireless."$MESH_SECTION"='wifi-iface'
uci set wireless."$MESH_SECTION".device="$RADIO5"
uci set wireless."$MESH_SECTION".mode='mesh'
uci set wireless."$MESH_SECTION".mesh_id="$MESH_ID"
uci set wireless."$MESH_SECTION".encryption='sae'
uci set wireless."$MESH_SECTION".key="$MESH_KEY"
uci set wireless."$MESH_SECTION".ieee80211w='2'
uci set wireless."$MESH_SECTION".sae_pwe='2'
uci set wireless."$MESH_SECTION".mesh_fwding='0'
uci set wireless."$MESH_SECTION".mesh_rssi_threshold='0'
uci set wireless."$MESH_SECTION".network='batmesh'
uci set wireless."$MESH_SECTION".disabled='0'

# =========================================================
# 15. LAN MANAGEMENT IP
# =========================================================
uci set network.lan.proto='static'
uci set network.lan.device='br-lan'
uci set network.lan.ipaddr="$NODE_IP"
uci set network.lan.netmask="$NODE_MASK"
uci set network.lan.gateway="$GATEWAY_IP"
uci set network.lan.dns="$DNS_IP"
uci set network.lan.ipv6='0'
uci set network.lan.delegate='0'

# =========================================================
# 16. DHCP SERVER DISABLED
# =========================================================
uci set dhcp.lan.ignore='1'
uci set dhcp.lan.ra='disabled'
uci set dhcp.lan.dhcpv6='disabled'
uci set dhcp.lan.ndp='disabled'

# =========================================================
# 17. HOSTNAME
# =========================================================
uci set system.@system[0].hostname="$NODE_NAME"

# =========================================================
# 18. COMMIT
# =========================================================
uci commit network
uci commit wireless
uci commit dhcp
uci commit system

# =========================================================
# 19. DISABLE ODHCPD
# =========================================================
/etc/init.d/odhcpd stop 2>/dev/null || true
/etc/init.d/odhcpd disable 2>/dev/null || true

# =========================================================
# 20. SCHEDULED REBOOT (EVERY 6 HOURS)
# =========================================================
mkdir -p /etc/crontabs
touch /etc/crontabs/root
# remove any previously scheduled reboots to avoid duplicates
sed -i '/reboot/d' /etc/crontabs/root 2>/dev/null || true
# add the every-6-hours reboot (at minute 0)
echo "0 */6 * * * /sbin/reboot" >> /etc/crontabs/root

# enable and start the scheduler
/etc/init.d/cron enable 2>/dev/null || true
/etc/init.d/cron restart 2>/dev/null || true

# =========================================================
# 21. APPLY CONFIGURATION
# ---------------------------------------------------------
# Not needed here: this script runs during the uci-defaults
# stage, BEFORE network and wireless services start - they
# will come up with this configuration already in place on
# this very first boot.
# =========================================================

# =========================================================
# 22. STATUS
# =========================================================
logger -t BATMAN "Configured $NODE_NAME $NODE_IP - Bridge + BATMAN-V mesh (first boot)" 2>/dev/null || true

echo ""
echo "======================================"
echo " CONFIGURATION COMPLETED (ROBUST)"
echo "======================================"
echo "Node       : $NODE_NAME"
echo "IP         : $NODE_IP"
echo "Mesh       : $MESH_ID (5GHz ch$MESH_CHANNEL $MESH_HTMODE, BATMAN_V)"
echo "Gateway    : $GATEWAY_IP"
echo "DNS        : $DNS_IP"
echo "AP 5GHz    : $SSID_5G (open, client isolation)"
echo "AP 2.4GHz  : $SSID_2G (open, client isolation)"
echo "STP        : Enabled (Safety against Loops)"
echo "Auto-Reboot: Every 6 hours"
echo "======================================"

exit 0
