# ==============================================================
#  Phicomm K2 (PSG1218) — MediaTek MT7620A — OpenWrt (Lean's lede)
#  Repo: NassarAlshabi1/phicomm_-K2_OPENWRT
#  Device profile: phicomm_k2-v22.4  (hardware version v22.4 or older)
#
#  الواجهة: LuCI مع ثيم Bootstrap — عربي + إنجليزي
#  الإضافات: UPnP + wpad كامل (WPA2/WPA3/802.11w)
#
#  ملاحظة: الـ workflow يمرر هذا الملف عبر make defconfig
#  فيكمل الناقص تلقائياً بالإعدادات الافتراضية.
# ==============================================================

# ---------- الجهاز المستهدف Target ----------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_ramips_mt7620_DEVICE_phicomm_k2-v22.4=y
CONFIG_TARGET_DEVICE_ramips_mt7620_DEVICE_phicomm_k2-v22.4=y

# ---------- واجهة الإدارة LuCI (ثيم Bootstrap الخفيف) ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y

# ---------- الترجمة: العربية + الإنجليزية ----------
CONFIG_PACKAGE_luci-i18n-base-ar=y
CONFIG_PACKAGE_luci-i18n-firewall-ar=y
CONFIG_PACKAGE_luci-i18n-package-manager-ar=y
CONFIG_PACKAGE_luci-i18n-upnp-ar=y

# ---------- Wi-Fi كامل: WPA2/WPA3/802.11w ----------
CONFIG_PACKAGE_wpad-wolfssl=y

# ---------- UPnP: فتح المنافذ تلقائياً للألعاب والبث ----------
CONFIG_PACKAGE_luci-app-upnp=y
