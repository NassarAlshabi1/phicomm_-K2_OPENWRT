#
# Phicomm K2 (v22.4 or older) — official OpenWrt 23.05.6 — English LuCI
# Floor1 mesh node: 802.11s on 5GHz (ch44/VHT80, WPA3-SAE) + BATMAN_V
# Open Aden-Net APs on both radios — management IP 10.0.0.8/16
#
# Target: ramips / mt7620 (MediaTek MT7620A @ 580 MHz, 8MB flash, 64MB RAM)
#

CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7620=y
CONFIG_TARGET_ramips_mt7620_DEVICE_phicomm_k2-v22.4=y

# --- Web interface (English is built-in, no i18n packages needed) ---
CONFIG_PACKAGE_luci=y

# --- Batman-adv mesh: BATMAN_V (must match on ALL nodes incl. the MikroTik gateway) ---
CONFIG_PACKAGE_kmod-batman-adv=y
CONFIG_BATMAN_ADV_BATMAN_V=y
CONFIG_BATMAN_ADV_BLA=y
CONFIG_BATMAN_ADV_DAT=y
CONFIG_BATMAN_ADV_MCAST=y
CONFIG_PACKAGE_batctl-default=y

# --- WPA3-SAE capable wpad for 802.11s protected mesh ---
CONFIG_PACKAGE_wpad-mesh-mbedtls=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set

# --- Mesh link management tools ---
CONFIG_PACKAGE_iw=y
